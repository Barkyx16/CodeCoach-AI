    "2 <= n <= 15",
    "the graph is acyclic"
  ],
  "examples": [
    {
      "input": "graph = [[1, 2], [3], [3], []]",
      "output": "[[0, 1, 3], [0, 2, 3]]"
    },
    {
      "input": "graph = [[4, 3, 1], [3, 2, 4], [3], [4], []]",
      "output": "[[0, 1, 2, 3, 4], [0, 1, 3, 4], [0, 1, 4], [0, 3, 4], [0, 4]]"
    },
    {
      "input": "graph = [[1], []]",
      "output": "[[0, 1]]"
    }
  ],
  "signature": {
    "method": "allPathsSourceTarget",
    "params": [
