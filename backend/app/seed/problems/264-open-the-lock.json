  "summary": "Fewest wheel turns to reach a code while avoiding dead ends.",
  "statement": "A lock has 4 wheels showing digits, starting at `\"0000\"`. One move turns one wheel one step up or down\n(9 wraps to 0 and back). Codes in `deadends` lock you out. Return the fewest moves to reach `target`,\nor `-1` if it's impossible.",
  "constraints": [
    "0 <= deadends.length <= 500",
    "target is not a deadend"
  ],
  "examples": [
    {
      "input": "deadends = [\"0201\", \"0101\", \"0102\", \"1212\", \"2002\"], target = \"0202\"",
      "output": "6"
    },
    {
      "input": "deadends = [\"8888\"], target = \"0009\"",
      "output": "1"
    },
    {
      "input": "deadends = [\"8887\", \"8889\", \"8878\", \"8898\", \"8788\", \"8988\", \"7888\", \"9888\"], target = \"8888\"",
      "output": "-1"
    }
  ],
  "signature": {
