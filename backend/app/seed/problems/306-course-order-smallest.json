      "output": "[0, 1, 2, 3]"
    },
    {
      "input": "n = 2, prereqs = [[0, 1], [1, 0]]",
      "output": "[]"
    },
    {
      "input": "n = 3, prereqs = []",
      "output": "[0, 1, 2]"
    }
  ],
