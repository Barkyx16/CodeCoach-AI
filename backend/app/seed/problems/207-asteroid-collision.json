  "hints": [
    "A collision only happens when a right-mover is followed by a left-mover.",
    "Keep survivors on a stack. A new left-mover fights the right-movers on top of the stack.",
    "stack = []\nfor a in asteroids:\n    alive = True\n    while alive and a < 0 and stack and stack[-1] > 0:\n        if stack[-1] < -a: stack.pop(); continue\n        if stack[-1] == -a: stack.pop()\n        alive = False\n    if alive: stack.append(a)\nreturn stack",
    "Each asteroid is pushed and popped at most once: O(n)."
  ],
  "expected_complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
