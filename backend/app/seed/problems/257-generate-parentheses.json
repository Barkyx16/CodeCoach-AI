      "input": "n = 1",
      "output": "[\"()\"]"
    },
    {
      "input": "n = 2",
      "output": "[\"(())\", \"()()\"]"
    }
  ],
  "signature": {
    "method": "generateParenthesis",
    "params": [
      {
        "name": "n",
        "type": "int"
      }
