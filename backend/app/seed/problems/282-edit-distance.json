  "starter_code": "class Solution {\n    public int minDistance(String a, String b) {\n        // TODO: write your solution here\n        return 0;\n    }\n}\n",
  "hints": [
    "Compare the last characters of the two prefixes.",
    "If they match, no cost; otherwise take 1 + the best of insert, delete or replace.",
    "dp[i][0] = i; dp[0][j] = j\nfor i, j:\n    if a[i-1] == b[j-1]: dp[i][j] = dp[i-1][j-1]\n    else: dp[i][j] = 1 + min(dp[i-1][j], dp[i][j-1], dp[i-1][j-1])\nreturn dp[n][m]",
    "O(n m) time; keeping two rows makes it O(m) space. Delete = up, insert = left, replace = diagonal."
  ],
  "expected_complexity": {
    "time": "O(n m)",
    "space": "O(n m)"
  },
