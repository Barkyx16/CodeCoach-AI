  "summary": "Group words that are anagrams of each other.",
  "statement": "Group the words of `words` that are anagrams of each other. Return one string per group: the\ngroup's words sorted alphabetically and joined with commas. Sort the groups alphabetically too.\nFor `[\"eat\",\"tea\",\"tan\",\"ate\",\"nat\",\"bat\"]` the answer is `[\"ate,eat,tea\", \"bat\", \"nat,tan\"]`.",
  "constraints": [
    "1 <= words.length <= 10^4",
    "0 <= words[i].length <= 100",
    "lower-case letters"
  ],
  "examples": [
    {
      "input": "words = [\"eat\", \"tea\", \"tan\", \"ate\", \"nat\", \"bat\"]",
      "output": "[\"ate,eat,tea\", \"bat\", \"nat,tan\"]"
    },
    {
      "input": "words = [\"\"]",
      "output": "[\"\"]"
    },
    {
      "input": "words = [\"a\"]",
      "output": "[\"a\"]"
    }
  ],
  "signature": {
