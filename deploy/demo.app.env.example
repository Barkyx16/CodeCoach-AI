# A public portfolio demo on the production compose (docs/DEMO.md, "Publishing it"): fictional
# sample learners, each visitor their own guest session, no email, no real accounts. Copy to
# deploy/.env.app on the server and fill in the blanks there; never commit the filled copy
# (.gitignore excludes .env.*). Use it with CODECOACH_DB=codecoach_demo in deploy/.env.production
# (the demo's database name must contain "demo"). DATABASE_URL is NOT set here: the compose file
# builds it per container.

DEMO_MODE=true

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# The site's https address, e.g. https://demo.example.com, and the same origin for CORS.
APP_BASE_URL=
CORS_ORIGINS=
# python -c "import secrets; print(secrets.token_urlsafe(48))" (for a metrics scraper; or METRICS_ENABLED=false)
METRICS_TOKEN=
RATE_LIMIT_BACKEND=database

# Demo mode sends no email (registration, resets and verification are refused), so no mail server.
EMAIL_BACKEND=file
EMAIL_FILE_DIR=/tmp/codecoach-demo-outbox

# Visitors' guest sessions are deleted a day after their last use; one address starts at most 20 a day.
ALLOW_GUEST_SESSIONS=true
GUEST_RETENTION_DAYS=1
GUEST_SESSIONS_PER_DAY=20

# The built-in coach: nothing is paid for. To show Claude instead, set AI_PROVIDER=anthropic and
# ANTHROPIC_API_KEY (from your secret store), keep the ceiling below low, and set a spending limit
# in the provider's console too (docs/SECURITY.md, "AI spending").
AI_PROVIDER=offline
AI_APP_DAILY_PAID_CALL_LIMIT=100
AI_UNVERIFIED_DAILY_REQUEST_LIMIT=10

# No judge: submissions are saved and said not to be run (the judge needs a Linux gVisor host).
EXECUTION_ENABLED=false
