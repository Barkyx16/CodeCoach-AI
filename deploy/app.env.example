# Copy to deploy/.env.app and fill in: the API's settings, passed whole to the migrate and api
# containers. Never committed (.gitignore excludes .env.*). DATABASE_URL is NOT set here: the
# compose file builds it per container (owner for migrate, app role for the API).
# Every setting is described in .env.example and docs/API.md.

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_BASE_URL=
CORS_ORIGINS=
METRICS_TOKEN=
RATE_LIMIT_BACKEND=database

# Email: production refuses anything but SMTP with TLS (docs/EMAIL.md).
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
