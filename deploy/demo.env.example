# A portfolio demo server (docs/DEMO.md): fictional data, per-visitor guest sessions, no email.
# Copy to a file outside the repository (e.g. backend/.env.demo) and run the API with it. This is a
# reviewable configuration, not a deployment: publishing a demo is a separate, authorized step.

# The demo's own database. Its name must contain "demo": `python -m app.cli demo-reset` refuses
# any other database, and any database holding a real account, before it changes anything.
DATABASE_URL=sqlite:///./codecoach-demo.db
# PostgreSQL instead: a database named like codecoach_demo, reset while connected as its owner (the
# API can use the app role). Put the connection URL in DATABASE_URL from your secret store; never
# commit it.

DEMO_MODE=true
# Local review only. A public demo needs ENVIRONMENT=production and its settings (docs/LAUNCH.md).
ENVIRONMENT=development
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The built-in coach: no AI service is called, so a visitor can't run up a bill.
AI_PROVIDER=offline
# No judge: submissions are saved and said not to be run. (EXECUTION_ENABLED needs the Linux
# sandbox and a runner: README "Quick start" and docs/REMOTE_JUDGE.md.)
EXECUTION_ENABLED=false
# Demo mode refuses every route that sends email; keep messages local anyway.
EMAIL_BACKEND=file
EMAIL_FILE_DIR=./demo-outbox
# Visitors' guest sessions are deleted a day after their last use.
GUEST_RETENTION_DAYS=1
ALLOW_GUEST_SESSIONS=true
