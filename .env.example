# CodeCoach AI configuration. Copy to `.env` and fill in. Never commit `.env`.
# Every variable is optional for local development; defaults are shown.
# Full reference: docs/API.md#environment-variables

# --- Core ---------------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

# PostgreSQL (docker compose provides this). For a no-Docker quick start you can use:
# DATABASE_URL=sqlite:///./codecoach.db
DATABASE_URL=postgresql+psycopg://codecoach:codecoach@localhost:5432/codecoach
POSTGRES_PASSWORD=codecoach        # used by docker-compose.yml only
AUTO_MIGRATE=true                  # create tables + seed on startup (dev only)

# --- Auth ---------------------------------------------------------------------------
# REQUIRED in production: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=60
ALLOW_GUEST_SESSIONS=true
AUTH_RATE_LIMIT_PER_MINUTE=10

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI coach -----------------------------------------------------------------------
AI_PROVIDER=offline                # offline (no key, free) | anthropic
ANTHROPIC_API_KEY=                 # required only when AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low               # low | medium | high
AI_DAILY_REQUEST_LIMIT=50          # per user, rolling 24h
AI_MAX_CODE_CHARS=12000            # code longer than this is truncated before reaching a model

# --- Code execution (docs/SECURITY.md §4) --------------------------------------------
# Needs gVisor ("runsc" Docker runtime) + the runner service. Start everything with:
#   docker compose --profile judge up --build
EXECUTION_ENABLED=false
RUNNER_TOKEN=                      # shared API<->runner secret, >= 32 chars: openssl rand -hex 32
RUNNER_URL=http://localhost:8100   # compose sets http://runner:8100 for the worker
JUDGE_TIME_LIMIT_S=15
SUBMISSION_RATE_LIMIT_PER_MINUTE=6
MAX_PENDING_PER_USER=2
MAX_QUEUE_DEPTH=200
JUDGE_MAX_ATTEMPTS=2               # retries for infrastructure failures only
EMBEDDED_WORKER=false              # true = run the worker inside the API process (dev only)
MAX_SOURCE_CHARS=20000
# Runner-only settings (runner/app/config.py):
# SANDBOX_RUNTIME=runsc            # runc is refused unless ALLOW_INSECURE_RUNTIME=true (dev only!)
# MAX_CONCURRENCY=2  WALL_TIMEOUT_S=20  MEMORY_MB=512  HEAP_MB=192  PIDS_LIMIT=64

# --- Observability ------------------------------------------------------------------
METRICS_ENABLED=true               # Prometheus metrics at /metrics

# --- Frontend (Vite reads VITE_* at build time; these are PUBLIC, never put secrets here)
VITE_API_BASE_URL=http://localhost:8000
