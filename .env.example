# CodeCoach AI configuration. Copy to `.env` and fill in. Never commit `.env`.
# Every variable is optional for local development; defaults are shown.
# Full reference: docs/API.md#environment-variables

# --- Core ---------------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
# ACCESS_LOG_FILE=./access.log   (local diagnostics only: each request's start and finish, no bodies, headers or query strings; off when unset)

# PostgreSQL (docker compose provides this). For a no-Docker quick start you can use:
# DATABASE_URL=sqlite:///./codecoach.db
# The password below is the local example; production refuses it (and the other example passwords).
DATABASE_URL=postgresql+psycopg://codecoach:codecoach@localhost:5432/codecoach
POSTGRES_PASSWORD=codecoach        # used by docker-compose.yml only
AUTO_MIGRATE=                      # blank = on for development, off in production (production refuses true)
DB_POOL_TIMEOUT_SECONDS=10         # a request waiting longer for a connection gets 503 server_busy

# --- Auth ---------------------------------------------------------------------------
# Blank (or a blank line like these) means "not set". Development then uses a fixed dev-only key.
# REQUIRED in production: a generated value. Production refuses the dev key, example or
# placeholder text, and repetitive strings. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Rotation: set the new SECRET_KEY and put the old one here until its tokens expire
# (REFRESH_TOKEN_TTL_DAYS). Comma-separated; accepted for checking only. docs/SECURITY.md.
SECRET_KEY_PREVIOUS=
ACCESS_TOKEN_TTL_MINUTES=15         # short: the browser keeps it in memory only
REFRESH_TOKEN_TTL_DAYS=30           # HttpOnly refresh cookie, rotated on every use
REFRESH_COOKIE_SECURE=              # blank = secure in production only (HTTPS); must not be false in production
ALLOW_GUEST_SESSIONS=true
AUTH_RATE_LIMIT_PER_MINUTE=10       # per client address (IPv6 by /64): sign-in, sign-up, reset, verification
LOGIN_FAILURES_PER_ACCOUNT=20       # wrong passwords per account per 15 minutes, from any address
REFRESH_RATE_LIMIT_PER_MINUTE=60    # session refreshes per address
EXPORTS_PER_HOUR=20                 # data exports per user
RESTORES_PER_HOUR=20                # backup checks/restores per user

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI coach -----------------------------------------------------------------------
AI_PROVIDER=offline                # offline (no key, free) | anthropic
ANTHROPIC_API_KEY=                 # required only when AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low               # low | medium | high
AI_DAILY_REQUEST_LIMIT=50          # per user, rolling 24h
AI_MAX_CONCURRENT_CALLS=8          # paid-provider calls at once per process; beyond that the offline coach answers
AI_MAX_CODE_CHARS=12000            # code longer than this is truncated before reaching a model

# --- Code execution (docs/SECURITY.md §4) --------------------------------------------
# Needs gVisor ("runsc" Docker runtime) + the runner service. Start everything with:
#   docker compose --profile judge up --build
EXECUTION_ENABLED=false
RUNNER_TOKEN=                      # shared API<->runner secret, >= 32 chars: openssl rand -hex 32
RUNNER_URL=http://localhost:8100   # compose sets http://runner:8100; a remote judge must be https:// (or an SSH tunnel to localhost)
RUNNER_CA_BUNDLE=                  # optional: a private CA to trust for an https runner (TLS is always verified)
QUEUE_STALL_SECONDS=120            # queued work older than this reports the judge as delayed
JUDGE_TIME_LIMIT_S=15
SUBMISSION_RATE_LIMIT_PER_MINUTE=6
MAX_PENDING_PER_USER=2
MAX_QUEUE_DEPTH=200
JUDGE_MAX_ATTEMPTS=2               # retries for infrastructure failures only
EMBEDDED_WORKER=false              # true = run the worker inside the API process (dev only)
MAX_SOURCE_CHARS=20000
# Runner-only settings (runner/app/config.py):
# SANDBOX_RUNTIME=runsc            # runc is refused unless ALLOW_INSECURE_RUNTIME=true (dev only!)
# MAX_CONCURRENCY=2  WALL_TIMEOUT_S=20  MEMORY_MB=512  HEAP_MB=192  PIDS_LIMIT=64

# --- Observability ------------------------------------------------------------------
METRICS_ENABLED=true               # Prometheus metrics at /metrics
METRICS_TOKEN=                     # scraper's bearer token (>= 32 chars); required in production while metrics are on

# --- Performance and background work (docs/PERFORMANCE.md "Sizing") ------------------
# WEB_CONCURRENCY=1                # uvicorn worker processes (the Docker image reads it)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
RESPONSE_CACHE_TTL_SECONDS=60      # public catalogue cache; 0 = off
BACKGROUND_JOBS_IN_API=true        # email retries + housekeeping in each API process

# --- Frontend (Vite reads VITE_* at build time; these are PUBLIC, never put secrets here)
VITE_API_BASE_URL=http://localhost:8000

# --- Email (password reset) ---------------------------------------------------------------
APP_BASE_URL=http://localhost:5173  # public web-app URL put into emailed links (https in production)
EMAIL_BACKEND=console               # console | file | smtp  (production requires smtp)
# EMAIL_FROM=CodeCoach AI <no-reply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls           # starttls (587) | ssl (465) | none (local test server only; refused in production)
# SMTP_CA_BUNDLE=                  # a private CA to trust; certificates and hostnames are always verified
# SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_TTL_MINUTES=30

# --- Abuse limits and retention -------------------------------------------------------------
RATE_LIMIT_BACKEND=database         # shared across API replicas; "memory" = one process only
# FORWARDED_ALLOW_IPS=10.0.0.5      # your reverse proxy / load balancer, so real client IPs are used
GUEST_RETENTION_DAYS=30             # delete guest accounts after this many inactive days (0 = never)

